# dlt secrets file (DO NOT commit to git)
# Copy this file to secrets.toml and fill in your actual credentials

[destination.postgres.credentials]
database = "process_mining_db"
password = "your_password"
username = "process_mining"
host = "postgres"
port = 5432
connect_timeout = 15

[sources.github]
# Get token from https://github.com/settings/tokens
access_token = "ghp_your_github_personal_access_token"

[sources.gitlab]
# Get token from https://gitlab.com/-/profile/personal_access_tokens
access_token = "glpat_your_gitlab_personal_access_token"

[sources.jira]
# Jira API token from https://id.atlassian.com/manage-profile/security/api-tokens
api_token = "your_jira_api_token"
email = "your_email@example.com"

[sources.jenkins]
# Jenkins API token or username:password
username = "your_jenkins_username"
api_token = "your_jenkins_api_token"
