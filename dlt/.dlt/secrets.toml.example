# dlt secrets file (DO NOT commit to git)
# Copy this file to secrets.toml and fill in your actual credentials

[destination.postgres.credentials]
database = "process_mining_db"
password = "your_password"
username = "process_mining"
host = "postgres"
port = 5432
connect_timeout = 15

[sources.github_source]
# Get token from https://github.com/settings/tokens
access_token = "ghp_your_github_personal_access_token"

[sources.gitlab_ci_source]
# Get token from https://gitlab.com/-/profile/personal_access_tokens
access_token = "glpat_your_gitlab_personal_access_token"

[sources.gitlab_issues_source]
# Same token for gitlab_issues_source module
access_token = "glpat_your_gitlab_personal_access_token"

[sources.gitlab_mr_source]
# Same token for gitlab_mr_source module
access_token = "glpat_your_gitlab_personal_access_token"

[sources.jira_source]
# Jira Personal Access Token or API token
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Note: For Cloud, use email + API token with Basic Auth. For Data Center, use PAT with Bearer.
access_token = "your_jira_access_token"

[sources.jenkins_source]
# Jenkins API token or username:password
username = "your_jenkins_username"
api_token = "your_jenkins_api_token"
